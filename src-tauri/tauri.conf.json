{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fetch",
  "version": "0.2.0",
  "identifier": "com.rexchao.fetch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:8080",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.output": "output"
    },
    "macOS": {
      "signingIdentity": "Developer ID Application: REX SHENJI CHAO (4L37ZXXDW8)",
      "entitlements": "Entitlements.plist"
    },
    "externalBin": [
      "binaries/node"
    ]
  }
}
